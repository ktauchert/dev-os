# Optional frontend env (copy to frontend/.env.local)
# See docs/aws-dev-workflow.md

# Dev API (Milestone 2+): API Gateway execute-api URL
# VITE_API_BASE_URL=https://xxxx.execute-api.region.amazonaws.com/dev

# Mock API via MSW (default: on in dev, off in production build)
# VITE_MOCK_API=true
# VITE_MOCK_API=false
